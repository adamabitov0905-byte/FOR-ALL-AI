{
	"geode": "v5.0.0",
	"gd": {
		"win": "2.2081"
	},
	"id": "hypermegahack.megahack",
	"name": "MegaHack",
	"version": "v1.0.0",
	"developer": "hypermegahack",
	"description": "In-game hack menu: noclip, bot, speedhack, hitboxes and practice music.",
	"links": {
		"source": "https://github.com/hypermegahack/megahack"
	},
	"tags": ["cheat", "gameplay", "utility", "offline"],
	"settings": {
		"menu-title": {
			"type": "title",
			"name": "Menu"
		},
		"open-menu": {
			"type": "keybind",
			"name": "Open MegaHack menu",
			"default": "Tab",
			"category": "universal"
		},
		"cheats-title": {
			"type": "title",
			"name": "Hacks"
		},
		"noclip": {
			"type": "bool",
			"name": "Noclip",
			"description": "Ignore death during a sandbox run.",
			"default": false
		},
		"bot": {
			"type": "bool",
			"name": "Bot",
			"description": "Automatic jump whenever the player touches the ground.",
			"default": false
		},
		"speedhack": {
			"type": "bool",
			"name": "Speedhack",
			"default": false
		},
		"speed-value": {
			"type": "float",
			"name": "Speed multiplier",
			"default": 1.0,
			"min": 0.1,
			"max": 3.0,
			"control": {
				"slider": true,
				"slider-step": 0.05,
				"arrows": true,
				"arrow-step": 0.1
			},
			"enable-if": "speedhack"
		},
		"practice-music": {
			"type": "bool",
			"name": "Practice music",
			"description": "Keep the level song when respawning.",
			"default": false
		},
		"visuals-title": {
			"type": "title",
			"name": "Visuals"
		},
		"hitbox": {
			"type": "bool",
			"name": "Hitboxes",
			"default": false
		},
		"hitbox-player": {
			"type": "bool",
			"name": "Player hitbox",
			"default": false,
			"enable-if": "hitbox"
		},
		"other-title": {
			"type": "title",
			"name": "Other"
		},
		"show-perms": {
			"type": "bool",
			"name": "Show permissions",
			"description": "Print the loaded mod list to the console when opening the menu.",
			"default": false
		},
		"safe-mode": {
			"type": "bool",
			"name": "Safe Mode",
			"description": "Cheats apply only in an editor playtest and never record progress.",
			"default": true
		}
	}
}
